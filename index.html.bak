<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Green Trends Kothapet - Staff & Payroll Management System</title>
  
  <!-- Progressive Web App (PWA) Meta & Manifest -->
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#07070d">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Green Trends">
  <link rel="apple-touch-icon" href="icon-192.png">

  <!-- Google Fonts: Outfit (Luxury Headings) & Plus Jakarta Sans (Clean UI Body) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            heading: ['Outfit', 'sans-serif'],
            syne: ['Outfit', 'sans-serif'],
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          },
          colors: {
            brand: {
              pink: '#ff2a85',
              pinkHover: '#ff4d9a',
              pinkLight: '#ff7eb3',
              pinkGlow: 'rgba(255, 42, 133, 0.35)',
              dark: '#050508',
              darkCard: '#0d0d15',
              darkCardLight: '#141420',
              darkBorder: '#1f1f30'
            }
          }
        }
      }
    }
  </script>
  
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Tesseract.js for In-Browser Schedule OCR -->
  <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>

  <!-- Google Firebase App & Firestore SDKs (100% Free Cloud Sync) -->
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore-compat.js"></script>

  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="styles.css">
</head>
<body class="bg-[#050508] text-white min-h-screen font-sans antialiased selection:bg-[#ff2a85] selection:text-white overflow-x-hidden">

  <!-- Ambient Glow Backgrounds -->
  <div class="fixed top-0 left-1/3 w-[32rem] h-[32rem] bg-[#ff2a85]/10 rounded-full blur-[160px] pointer-events-none -z-10"></div>
  <div class="fixed bottom-0 right-1/4 w-[36rem] h-[36rem] bg-[#ff2a85]/8 rounded-full blur-[180px] pointer-events-none -z-10"></div>

  <!-- ========================================== -->
  <!-- AUTHENTICATION / LOGIN OVERLAY SCREEN     -->
  <!-- ========================================== -->
  <div id="loginOverlay" class="fixed inset-0 z-50 bg-[#040407]/95 backdrop-blur-2xl flex items-center justify-center p-4 min-h-screen overflow-hidden">
    <div id="loginCard" class="w-full max-w-md bg-[#0b0b14] border border-[#ff2a85]/35 rounded-[32px] p-7 sm:p-9 shadow-2xl shadow-[#ff2a85]/15 relative overflow-hidden">
      <!-- Glow background inside modal -->
      <div class="absolute -top-24 -left-24 w-48 h-48 bg-[#ff2a85]/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-48 h-48 bg-[#ff2a85]/15 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Salon Logo & Header -->
      <div class="flex flex-col items-center text-center relative z-10 mb-7">
        <div class="w-16 h-16 rounded-3xl bg-gradient-to-tr from-[#ff2a85] via-[#ff5c99] to-[#ff7eb3] p-0.5 shadow-xl shadow-[#ff2a85]/30 flex items-center justify-center mb-4">
          <div class="w-full h-full bg-[#08080f] rounded-[22px] flex items-center justify-center">
            <i class="fa-solid fa-scissors text-[#ff2a85] text-2xl"></i>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <h1 class="font-syne font-extrabold text-2xl tracking-wider bg-gradient-to-r from-white via-pink-100 to-[#ff7eb3] bg-clip-text text-transparent">
            GREEN TRENDS
          </h1>
          <span class="text-[10px] font-extrabold px-2.5 py-0.5 rounded-full bg-[#ff2a85]/25 text-[#ff7eb3] border border-[#ff2a85]/40 tracking-wider">
            KOTHAPET
          </span>
        </div>
        <p class="text-xs text-gray-400 mt-1.5 font-medium">Salon Attendance & Payroll Portal</p>
      </div>

      <!-- Login Form -->
      <form id="loginForm" onsubmit="handleLoginSubmit(event)" class="space-y-4 relative z-10">
        <!-- Error Alert (Hidden by default) -->
        <div id="loginErrorAlert" class="hidden p-3 rounded-2xl bg-rose-500/15 border border-rose-500/30 text-rose-300 text-xs flex items-center gap-2.5">
          <i class="fa-solid fa-triangle-exclamation text-rose-400 text-sm"></i>
          <span id="loginErrorMsg">Incorrect username or password. Please try again.</span>
        </div>

        <!-- Username Input -->
        <div>
          <label class="block text-gray-300 text-xs font-bold mb-1.5 tracking-wide">
            Username
          </label>
          <div class="relative flex items-center">
            <span class="absolute left-3.5 text-gray-500 text-sm">
              <i class="fa-solid fa-user"></i>
            </span>
            <input type="text" id="loginUsername" required autocomplete="username" placeholder="Enter username"
              class="w-full bg-[#12121e] border border-[#232338] rounded-2xl pl-10 pr-4 py-3 text-white text-sm font-semibold placeholder-gray-500 focus:outline-none focus:border-[#ff2a85] focus:ring-1 focus:ring-[#ff2a85]/50 transition-all">
          </div>
        </div>

        <!-- Password Input with Toggle Eye -->
        <div>
          <label class="block text-gray-300 text-xs font-bold mb-1.5 tracking-wide">
            Password
          </label>
          <div class="relative flex items-center">
            <span class="absolute left-3.5 text-gray-500 text-sm">
              <i class="fa-solid fa-lock"></i>
            </span>
            <input type="password" id="loginPassword" required autocomplete="current-password" placeholder="Enter password"
              class="w-full bg-[#12121e] border border-[#232338] rounded-2xl pl-10 pr-11 py-3 text-white text-sm font-semibold placeholder-gray-500 focus:outline-none focus:border-[#ff2a85] focus:ring-1 focus:ring-[#ff2a85]/50 transition-all">
            <button type="button" onclick="togglePasswordVisibility()" 
              class="absolute right-3.5 text-gray-500 hover:text-gray-300 transition-colors p-1" title="Show/Hide Password">
              <i id="passwordEyeIcon" class="fa-solid fa-eye-slash text-xs"></i>
            </button>
          </div>
        </div>

        <!-- Remember Me Checkbox -->
        <div class="flex items-center justify-between text-xs pt-1">
          <label class="flex items-center gap-2 cursor-pointer select-none text-gray-400 hover:text-gray-300">
            <input type="checkbox" id="loginRememberMe" checked 
              class="w-4 h-4 rounded-md bg-[#131320] border-[#292940] text-[#ff2a85] focus:ring-0 focus:ring-offset-0 cursor-pointer">
            <span>Remember me</span>
          </label>
          <span class="text-[11px] text-gray-500 flex items-center gap-1">
            <i class="fa-solid fa-lock text-[10px]"></i> Secured
          </span>
        </div>

        <!-- Submit Button -->
        <button type="submit" id="loginSubmitBtn"
          class="w-full py-3.5 mt-2 rounded-2xl font-syne font-bold text-sm bg-gradient-to-r from-[#ff2a85] via-[#ff4d9a] to-[#ff7eb3] hover:brightness-110 text-white shadow-xl shadow-[#ff2a85]/30 active:scale-[0.99] transition-all flex items-center justify-center gap-2">
          <span>Sign In to Portal</span>
          <i class="fa-solid fa-arrow-right-to-bracket text-xs"></i>
        </button>
      </form>
    </div>
  </div>

  <!-- Top Navigation Header - Ultra-Luxury Design -->
  <header class="sticky top-0 z-40 bg-[#07070d]/95 backdrop-blur-xl border-b border-[#1c1c2e] shadow-2xl shadow-black/80">
    <div class="w-full max-w-[1720px] mx-auto px-2 sm:px-4 lg:px-6 h-16 flex items-center justify-between gap-2 lg:gap-3">
      
      <!-- Brand: strictly GREEN TRENDS KOTHAPET -->
      <div class="flex items-center gap-2 sm:gap-2.5 cursor-pointer select-none shrink-0" onclick="navigateTo('attendance')">
        <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#ff2a85] to-purple-600 p-0.5 shadow-md shadow-[#ff2a85]/20 flex items-center justify-center">
          <div class="w-full h-full bg-[#080811] rounded-[10px] flex items-center justify-center">
            <i class="fa-solid fa-scissors text-[#ff2a85] text-xs"></i>
          </div>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="font-heading font-black text-sm sm:text-base tracking-wider text-white">GREEN TRENDS</span>
          <span class="text-[9px] font-extrabold px-1.5 py-0.5 rounded-md bg-[#ff2a85]/20 text-[#ff7eb3] border border-[#ff2a85]/35 tracking-widest uppercase">
            KOTHAPET
          </span>
        </div>
      </div>

      <!-- Navigation Tabs (Sleek Luxury Tabs, Overflow-Protected) -->
      <nav id="mainNav" class="hidden lg:flex items-center gap-0.5 xl:gap-1 bg-[#0c0c16]/95 p-1 rounded-2xl border border-[#222238] shadow-2xl shrink-0 overflow-x-auto no-scrollbar">
        <button id="navBtn-attendance" onclick="navigateTo('attendance')" 
          class="nav-tab active px-2.5 xl:px-3 py-1.5 rounded-xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 cursor-pointer whitespace-nowrap">
          <i class="fa-solid fa-calendar-check text-[#ff2a85]"></i>
          <span>Attendance</span>
        </button>

        <button id="navBtn-kiosk" onclick="navigateTo('kiosk')" 
          class="nav-tab px-2.5 xl:px-3 py-1.5 rounded-xl text-xs font-bold text-gray-400 hover:text-white transition-all duration-200 flex items-center gap-1.5 cursor-pointer whitespace-nowrap" title="Front Desk Stylist 1-Tap Self Check-In">
          <i class="fa-solid fa-stopwatch text-emerald-400"></i>
          <span>Kiosk</span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        </button>

        <button id="navBtn-payroll" onclick="navigateTo('payroll')" 
          class="nav-tab px-2.5 xl:px-3 py-1.5 rounded-xl text-xs font-bold text-gray-400 hover:text-white transition-all duration-200 flex items-center gap-1.5 cursor-pointer whitespace-nowrap">
          <i class="fa-solid fa-file-invoice-dollar text-[#ff2a85]"></i>
          <span>Payroll</span>
        </button>

        <button id="navBtn-incentives" onclick="navigateTo('incentives')" 
          class="nav-tab px-2.5 xl:px-3 py-1.5 rounded-xl text-xs font-bold text-gray-400 hover:text-white transition-all duration-200 flex items-center gap-1.5 cursor-pointer whitespace-nowrap">
          <i class="fa-solid fa-trophy text-[#ff2a85]"></i>
          <span>Incentives</span>
        </button>

        <button id="navBtn-expenses" onclick="navigateTo('expenses')" 
          class="nav-tab px-2.5 xl:px-3 py-1.5 rounded-xl text-xs font-bold text-gray-400 hover:text-white transition-all duration-200 flex items-center gap-1.5 cursor-pointer whitespace-nowrap" title="Salon Petty Cash & Daily Expenses">
          <i class="fa-solid fa-receipt text-amber-400"></i>
          <span>Petty Cash</span>
        </button>

        <button id="navBtn-roster" onclick="navigateTo('roster')" 
          class="nav-tab px-2.5 xl:px-3 py-1.5 rounded-xl text-xs font-bold text-gray-400 hover:text-white transition-all duration-200 flex items-center gap-1.5 cursor-pointer whitespace-nowrap">
          <i class="fa-solid fa-camera text-[#ff2a85]"></i>
          <span>Roster</span>
        </button>

        <button id="navBtn-admin" onclick="navigateTo('admin')" 
          class="nav-tab px-2.5 xl:px-3 py-1.5 rounded-xl text-xs font-bold text-gray-400 hover:text-white transition-all duration-200 flex items-center gap-1.5 cursor-pointer whitespace-nowrap" title="Salon Settings, Percentages & Credentials">
          <i class="fa-solid fa-sliders text-[#ff2a85]"></i>
          <span>Admin</span>
        </button>
      </nav>

      <!-- Right Header: Compact Status, Install App & Integrated User Pill -->
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <!-- Quick Kiosk Button on tablets / mobile (< lg screens) -->
        <button type="button" onclick="navigateTo('kiosk')" 
          class="flex lg:hidden items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-500/30 text-emerald-400 text-xs font-bold transition-all cursor-pointer">
          <i class="fa-solid fa-stopwatch text-emerald-400"></i>
          <span>Kiosk</span>
        </button>

        <!-- Sleek Live Clock (Desktop screens >= 1440px) -->
        <div class="hidden 2xl:flex items-center gap-1.5 bg-[#0d0d18] border border-[#242438] px-2.5 py-1.5 rounded-2xl shadow-xl shadow-black/40">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="liveTime" class="text-xs font-mono font-bold text-white tracking-wider tabular-nums">--:--</span>
        </div>

        <!-- Compact Cloud Sync Status Badge (Quiet Indicator) -->
        <button type="button" id="cloudSyncHeaderBadge" onclick="navigateTo('admin')" 
          class="hidden sm:flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-[#0d0d18] border border-[#222238] text-[11px] font-mono font-bold transition-all hover:border-[#ff2a85]/50 cursor-pointer shrink-0" title="Cloud Sync Status">
          <span id="cloudSyncHeaderDot" class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="cloudSyncHeaderText" class="text-emerald-400 font-bold"><i class="fa-solid fa-cloud text-emerald-400 mr-1"></i>Live</span>
        </button>

        <!-- Quick Install App / Mobile Mode -->
        <button type="button" id="installPwaBtn" onclick="promptPwaInstall()" 
          class="flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-xl bg-gradient-to-r from-[#ff2a85]/20 to-purple-500/20 hover:from-[#ff2a85]/35 hover:to-purple-500/35 border border-[#ff2a85]/40 text-[#ff7eb3] hover:text-white text-xs font-bold transition-all shadow-sm cursor-pointer shrink-0" 
          title="Install App / Add to Home Screen">
          <i class="fa-solid fa-mobile-screen-button text-xs text-[#ff2a85]"></i>
          <span class="hidden md:inline">Install</span>
        </button>

        <!-- Combined Luxury User Badge & Quick Logout in One Pill (Never Clipped) -->
        <div id="userHeaderBadge" class="hidden flex items-center bg-[#0d0d18] border border-[#222238] p-0.5 rounded-2xl shadow-lg shrink-0">
          <div class="flex items-center gap-1.5 px-2 sm:px-2.5 py-1 text-xs font-bold text-gray-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span id="headerUserName">Manager</span>
          </div>
          <button type="button" onclick="logoutUser()" 
            class="px-2 py-1 rounded-xl text-xs font-bold text-rose-400 hover:text-white hover:bg-rose-500/20 transition-all flex items-center gap-1 cursor-pointer" title="Sign Out">
            <i class="fa-solid fa-power-off text-[10px]"></i>
            <span class="hidden sm:inline text-xs font-semibold">Logout</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Notification Toast Container (Floats right below header on Mobile, Top-Right on Desktop) -->
  <div id="toastContainer" class="fixed top-20 left-1/2 -translate-x-1/2 sm:left-auto sm:right-5 sm:translate-x-0 z-50 flex flex-col items-center sm:items-end gap-2 pointer-events-none w-[92%] sm:w-auto max-w-sm"></div>

  <!-- Main Content Container -->
  <main class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-5 pb-28 md:pb-10">

    <!-- ========================================== -->
    <!-- VIEW 1: DAILY ATTENDANCE & SHIFT TRACKER   -->
    <!-- ========================================== -->
    <section id="view-attendance" class="view-panel block space-y-6">
      
      <!-- Top Action & Date Bar -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-[#0d0d15] p-5 rounded-3xl border border-[#1f1f30] shadow-2xl">
        <div>
          <h1 class="text-2xl font-syne font-extrabold text-white flex items-center gap-3">
            <span>Daily Attendance & Timesheet</span>
            <span class="text-xs font-sans font-bold px-3 py-1 rounded-full bg-[#ff2a85]/15 text-[#ff7eb3] border border-[#ff2a85]/30">
              9-Hr Shift Standard
            </span>
          </h1>
          <p class="text-xs text-gray-400 mt-1 font-medium">
            Daily check-in (AM/PM) and check-out (Always PM). Shortfall from 9 hours deducts from monthly OT.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <!-- Quick Day Buttons: Yesterday, Today, Tomorrow -->
          <div class="inline-flex items-center bg-[#131320] rounded-2xl border border-[#252538] p-1 shadow-inner">
            <button onclick="shiftDate(-1)" 
              class="px-3 py-1.5 rounded-xl text-xs font-bold text-gray-400 hover:text-white hover:bg-[#1f1f33] transition-all flex items-center gap-1.5 cursor-pointer" 
              title="Go to Yesterday">
              <i class="fa-solid fa-angle-left text-[11px]"></i>
              <span>Yesterday</span>
            </button>
            
            <button onclick="setTodayDate()" 
              class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-[#ff2a85]/20 hover:bg-[#ff2a85]/30 text-[#ff7eb3] border border-[#ff2a85]/40 transition-all cursor-pointer shadow-sm" 
              title="Go to Today">
              Today
            </button>

            <button onclick="shiftDate(1)" 
              class="px-3 py-1.5 rounded-xl text-xs font-bold text-gray-400 hover:text-white hover:bg-[#1f1f33] transition-all flex items-center gap-1.5 cursor-pointer" 
              title="Go to Tomorrow">
              <span>Tomorrow</span>
              <i class="fa-solid fa-angle-right text-[11px]"></i>
            </button>
          </div>

          <!-- Quick Date Selector -->
          <div class="flex items-center bg-[#131320] rounded-2xl border border-[#252538] px-3 py-1.5 shadow-inner">
            <i class="fa-regular fa-calendar text-gray-400 text-xs mr-2"></i>
            <input type="date" id="selectedDateInput" onchange="onDateChanged()" 
              class="bg-transparent text-white text-xs font-bold focus:outline-none cursor-pointer font-mono">
          </div>

          <button onclick="bulkMarkAllPresent()" 
            class="px-5 py-2.5 rounded-2xl text-xs font-bold bg-gradient-to-r from-[#ff2a85] to-[#ff5c99] hover:brightness-110 text-white shadow-xl shadow-[#ff2a85]/25 transition-all flex items-center gap-2 cursor-pointer">
            <i class="fa-solid fa-check-double"></i>
            <span>Mark All Present</span>
          </button>

          <button onclick="clearAllAttendanceDataToZero(this)" 
            class="px-4 py-2.5 rounded-2xl text-xs font-bold bg-amber-950/40 hover:bg-amber-900/60 text-amber-200 border border-amber-800/50 transition-all flex items-center gap-1.5 shadow-lg shadow-amber-950/30 cursor-pointer" title="Wipe all data and reset to 0">
            <i class="fa-solid fa-rotate-left text-amber-400"></i>
            <span>Reset All to 0</span>
          </button>
        </div>
      </div>

      <!-- Quick KPI Metric Cards - Crisp Typography, Zero Distortion -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5">
        <!-- Present Card -->
        <div class="bg-[#0d0d18] p-4 rounded-2xl border border-[#222238] shadow-lg relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs text-gray-400 font-semibold tracking-wide">Present Today</span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse shadow-md shadow-emerald-400/50"></span>
          </div>
          <div class="mt-2.5 flex items-baseline gap-1.5">
            <span id="kpiPresentCount" class="text-2xl font-black font-heading text-white tracking-tight">0</span>
            <span class="text-xs text-gray-400 font-bold">/ 8 Staff</span>
          </div>
        </div>

        <!-- Weekly Off Card -->
        <div class="bg-[#0d0d18] p-4 rounded-2xl border border-[#222238] shadow-lg">
          <div class="flex items-center justify-between">
            <span class="text-xs text-gray-400 font-semibold tracking-wide">Weekly Off</span>
            <i class="fa-solid fa-mug-hot text-indigo-400 text-xs"></i>
          </div>
          <div class="mt-2.5 flex items-baseline justify-between">
            <span id="kpiWeeklyOffCount" class="text-2xl font-black font-heading text-indigo-400 tracking-tight">0</span>
            <span class="text-[10px] text-gray-500 font-medium">1/wk allowed</span>
          </div>
        </div>

        <!-- Leaves Card -->
        <div class="bg-[#0d0d18] p-4 rounded-2xl border border-[#222238] shadow-lg">
          <div class="flex items-center justify-between">
            <span class="text-xs text-gray-400 font-semibold tracking-wide">Leaves (Cut)</span>
            <i class="fa-solid fa-user-xmark text-rose-400 text-xs"></i>
          </div>
          <div class="mt-2.5 flex items-baseline justify-between">
            <span id="kpiLeaveCount" class="text-2xl font-black font-heading text-rose-400 tracking-tight">0</span>
            <span class="text-[10px] text-rose-400/80 font-bold">Salary cut</span>
          </div>
        </div>

        <!-- Overtime Card -->
        <div class="bg-[#0d0d18] p-4 rounded-2xl border border-[#222238] shadow-lg">
          <div class="flex items-center justify-between">
            <span class="text-xs text-gray-400 font-semibold tracking-wide">Today's OT</span>
            <i class="fa-solid fa-clock text-[#ff2a85] text-xs"></i>
          </div>
          <div class="mt-2.5">
            <span id="kpiOvertimePay" class="text-2xl font-black font-heading text-[#ff7eb3] tracking-tight">₹0</span>
            <span id="kpiOvertimeHours" class="text-[10px] text-gray-500 block font-mono font-medium">0 hrs logged</span>
          </div>
        </div>

        <!-- Services Done Card -->
        <div class="bg-[#0d0d18] p-4 rounded-2xl border border-[#222238] shadow-lg">
          <div class="flex items-center justify-between">
            <span class="text-xs text-gray-400 font-semibold tracking-wide">Services Logged</span>
            <i class="fa-solid fa-spa text-purple-400 text-xs"></i>
          </div>
          <div class="mt-2.5">
            <span id="kpiServicesTotal" class="text-2xl font-black font-heading text-purple-400 tracking-tight">₹0</span>
            <span class="text-[10px] text-gray-500 block font-medium">Daily Total</span>
          </div>
        </div>

        <!-- Products Sold Card -->
        <div class="bg-[#0d0d18] p-4 rounded-2xl border border-[#222238] shadow-lg">
          <div class="flex items-center justify-between">
            <span class="text-xs text-gray-400 font-semibold tracking-wide">Products Sold</span>
            <i class="fa-solid fa-bag-shopping text-pink-400 text-xs"></i>
          </div>
          <div class="mt-2.5">
            <span id="kpiProductsTotal" class="text-2xl font-black font-heading text-pink-400 tracking-tight">₹0</span>
            <span class="text-[10px] text-gray-500 block font-medium">Daily Total</span>
          </div>
        </div>
      </div>

      <!-- Staff Attendance Cards (Two-Tier Layout: Products box cannot overflow) -->
      <div class="space-y-4" id="staffAttendanceContainer">
        <!-- Rendered dynamically by JS -->
      </div>

      <!-- Bottom Save / Confirmation Floating Bar (Clearance above mobile nav) -->
      <div class="sticky bottom-20 md:bottom-6 z-30 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-[#0e0e18]/95 backdrop-blur-md p-3.5 sm:p-4 rounded-2xl border border-[#222236] shadow-2xl">
        <div class="flex items-center gap-2 text-xs text-gray-300">
          <i class="fa-solid fa-cloud-arrow-up text-[#ff2a85] shrink-0"></i>
          <span class="text-[11px] sm:text-xs">All times and attendance changes save automatically.</span>
        </div>
        <button onclick="saveAttendanceToast()" 
          class="w-full sm:w-auto px-5 py-2.5 rounded-xl text-xs font-extrabold bg-gradient-to-r from-[#ff2a85] to-[#ff5c99] hover:brightness-110 text-white transition-all shadow-lg shadow-[#ff2a85]/30 flex items-center justify-center gap-2 cursor-pointer">
          <i class="fa-solid fa-floppy-disk"></i>
          <span>Save Day Record</span>
        </button>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- VIEW: FRONT DESK KIOSK MODE (1-TAP)        -->
    <!-- ========================================== -->
    <section id="view-kiosk" class="view-panel hidden space-y-6">
      
      <!-- Kiosk Hero Header Banner -->
      <div class="bg-gradient-to-r from-[#0e0e1a] via-[#120f20] to-[#0e0e1a] p-5 sm:p-7 rounded-3xl border border-[#2b2040] shadow-2xl relative overflow-hidden">
        <!-- Background Ambient Glow -->
        <div class="absolute -right-20 -top-20 w-72 h-72 bg-[#ff2a85]/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -left-20 -bottom-20 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-5">
          <!-- Left: Title, Live Digital Clock & Date -->
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 text-[10px] font-bold font-mono uppercase tracking-wider flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                <span>FRONT DESK RECEPTION KIOSK</span>
              </span>
              <span class="text-xs text-gray-500">•</span>
              <span id="kioskLiveDate" class="text-xs text-gray-300 font-semibold font-mono">--</span>
            </div>

            <div class="flex items-baseline gap-3">
              <div class="text-3xl sm:text-5xl font-black font-mono text-white tracking-wider tabular-nums text-transparent bg-clip-text bg-gradient-to-r from-white via-pink-100 to-[#ff7eb3]" id="kioskDigitalClock">
                --:--:-- --
              </div>
            </div>

            <p class="text-xs text-gray-400 font-medium">
              Stylists tap your card once to instantly record your shift check-in or check-out time.
            </p>
          </div>

          <!-- Right: Kiosk Controls (Fullscreen toggle & Live Shift Summary) -->
          <div class="flex flex-wrap items-center gap-2.5">
            <div id="kioskStatsTicker" class="flex flex-wrap items-center gap-2 bg-[#090912]/80 backdrop-blur-md p-2 rounded-2xl border border-[#232338]">
              <!-- Dynamically populated: X On Duty, Y Off, Z Pending -->
            </div>

            <button type="button" onclick="toggleKioskFullscreen()" id="kioskFullscreenBtn" 
              class="px-4 py-2.5 rounded-2xl text-xs font-bold bg-[#141426] hover:bg-[#1f1f38] text-gray-200 hover:text-white border border-[#2b2b46] flex items-center gap-2 transition-all cursor-pointer shadow-lg shadow-black/40">
              <i class="fa-solid fa-expand text-purple-400"></i>
              <span>Fullscreen Kiosk</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Kiosk Stylist Cards Grid (Big Touch Targets) -->
      <div id="kioskStaffGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <!-- Rendered dynamically by JS -->
      </div>

    </section>

    <!-- ========================================== -->
    <!-- VIEW 3: MONTHLY SALARY & PAYROLL SHEET     -->
    <!-- ========================================== -->
    <section id="view-payroll" class="view-panel hidden space-y-6">
      
      <!-- Payroll Month Selector Bar - Ultra-Luxe Design (Image 2 Fix) -->
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-5 bg-gradient-to-r from-[#0d0d18] via-[#090912] to-[#0d0d18] p-6 rounded-3xl border border-[#222238] shadow-2xl shadow-black/80">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-[#ff2a85] to-[#ff7eb3] p-0.5 shadow-lg shadow-[#ff2a85]/30 flex-shrink-0">
            <div class="w-full h-full bg-[#090912] rounded-[14px] flex items-center justify-center">
              <i class="fa-solid fa-file-invoice-dollar text-[#ff7eb3] text-xl"></i>
            </div>
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-2.5">
              <h1 class="text-2xl font-black font-heading text-white tracking-tight">
                Monthly Payroll & Salary Sheet
              </h1>
              <span id="payrollMonthBadge" class="text-xs font-bold px-3 py-1 rounded-full bg-[#ff2a85]/20 text-[#ff7eb3] border border-[#ff2a85]/40 tracking-wide uppercase">
                September 2026
              </span>
            </div>
            <p class="text-xs text-gray-400 mt-1 font-medium">
              Strict per-day salary (Base ÷ Month Days), shortfall OT deductions, and percentage commissions.
            </p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <!-- Month Selector -->
          <div class="flex items-center bg-[#131322] rounded-2xl border border-[#26263e] hover:border-[#ff2a85]/50 px-4 py-2.5 shadow-inner transition-all">
            <i class="fa-regular fa-calendar text-[#ff7eb3] mr-2 text-xs"></i>
            <input type="month" id="selectedMonthInput" onchange="onPayrollMonthChanged()" 
              class="bg-transparent text-white text-xs font-bold focus:outline-none cursor-pointer font-mono tracking-wide">
          </div>

          <!-- Print Paysheet -->
          <button onclick="window.print()" 
            class="px-4 py-2.5 rounded-2xl text-xs font-bold bg-[#161628] hover:bg-[#202038] text-gray-200 hover:text-white border border-[#26263e] transition-all flex items-center gap-2 shadow-md cursor-pointer">
            <i class="fa-solid fa-print text-gray-400"></i>
            <span>Print Sheet</span>
          </button>

          <!-- Export CSV -->
          <button onclick="exportPayrollCSV()" 
            class="px-5 py-2.5 rounded-2xl text-xs font-extrabold bg-gradient-to-r from-[#ff2a85] to-[#ff5c99] hover:brightness-110 text-white shadow-lg shadow-[#ff2a85]/30 transition-all flex items-center gap-2 cursor-pointer">
            <i class="fa-solid fa-file-csv"></i>
            <span>Export CSV</span>
          </button>
        </div>
      </div>

      <!-- Master Payroll Table Card -->
      <div class="bg-[#0d0d15] rounded-3xl border border-[#1f1f30] overflow-hidden shadow-2xl">
        <div class="p-5 border-b border-[#1f1f30] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="font-syne font-bold text-lg text-white">Staff Salary Breakdown</h2>
            <p class="text-xs text-gray-400 mt-0.5">Kalyan: 1% salon revenue | Stylists: 5% service commission & tiered product % | Mid-month advances deducted from net.</p>
          </div>
          <span class="text-xs text-gray-400">Total Staff: <strong class="text-white">8 Members</strong></span>
        </div>

        <!-- Mobile Horizontal Swipe Guidance Indicator -->
        <div class="md:hidden flex items-center justify-between px-4 py-2.5 bg-gradient-to-r from-[#ff2a85]/15 via-purple-500/10 to-[#ff2a85]/15 border-b border-[#1f1f30] text-[11px] text-[#ff7eb3] font-semibold">
          <span class="flex items-center gap-2">
            <i class="fa-solid fa-arrows-left-right text-[#ff2a85] animate-pulse"></i>
            <span>Swipe horizontally to view all 13 columns</span>
          </span>
          <span class="text-gray-400 text-[10px] font-mono">Net Pay & Slip ➔</span>
        </div>

        <!-- Responsive Table with Perfect Width Fit & Smooth Touch Scrolling -->
        <div class="overflow-x-auto touch-scroll">
          <table class="w-full text-left border-collapse text-xs whitespace-nowrap">
            <thead>
              <tr class="bg-[#12121e] text-gray-400 border-b border-[#1f1f30] uppercase tracking-wider font-bold text-[11px]">
                <th class="py-3 px-3 sticky-first-col">Staff Member</th>
                <th class="py-3 px-2">Base Salary</th>
                <th class="py-3 px-2">Food</th>
                <th class="py-3 px-2">Per Day</th>
                <th class="py-3 px-2 text-center">Attd (P/WO)</th>
                <th class="py-3 px-2 text-center">Leaves (Cut)</th>
                <th class="py-3 px-2">Leave Cut</th>
                <th class="py-3 px-2 text-center">Net OT</th>
                <th class="py-3 px-2">OT Pay</th>
                <th class="py-3 px-2">Incentives</th>
                <th class="py-3 px-2 text-center text-rose-300 font-bold">Advance / Loan</th>
                <th class="py-3 px-3 font-bold text-[#ff7eb3] text-right">Net Payable</th>
                <th class="py-3 px-3 text-center">Pay Slip</th>
              </tr>
            </thead>
            <tbody id="payrollTableBody" class="divide-y divide-[#171726] text-gray-200">
              <!-- Rendered dynamically by JS -->
            </tbody>
            <tfoot id="payrollTableFoot" class="bg-[#10101b] font-bold text-white border-t-2 border-[#242438]">
              <!-- Totals row rendered by JS -->
            </tfoot>
          </table>
        </div>
      </div>

      <!-- Monthly Summary Highlight Cards - Clean Crisp Typography -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-[#0d0d18] p-5 rounded-3xl border border-[#222238] shadow-lg">
          <span class="text-xs text-gray-400 uppercase tracking-wider font-semibold">Total Gross Payroll</span>
          <div class="mt-2 text-2xl font-black font-heading text-white tracking-tight" id="summaryGrossBase">₹0</div>
          <span class="text-[11px] text-gray-500 mt-1 block">Base + Food Allowances</span>
        </div>

        <div class="bg-[#0d0d18] p-5 rounded-3xl border border-[#222238] shadow-lg">
          <span class="text-xs text-gray-400 uppercase tracking-wider font-semibold">Total Leave Deductions</span>
          <div class="mt-2 text-2xl font-black font-heading text-rose-400 tracking-tight" id="summaryDeductions">₹0</div>
          <span class="text-[11px] text-rose-400/80 mt-1 block font-medium">For unpaid leaves</span>
        </div>

        <div class="bg-[#0d0d18] p-5 rounded-3xl border border-[#222238] shadow-lg">
          <span class="text-xs text-gray-400 uppercase tracking-wider font-semibold">Net Overtime & Incentives</span>
          <div class="mt-2 text-2xl font-black font-heading text-[#ff7eb3] tracking-tight" id="summaryAdditions">₹0</div>
          <span class="text-[11px] text-gray-500 mt-1 block">OT (Shortfall Net) + Commissions</span>
        </div>

        <div class="bg-gradient-to-br from-[#1a0b1c] to-[#0d0d18] p-5 rounded-3xl border border-[#ff2a85]/40 shadow-xl shadow-[#ff2a85]/10">
          <span class="text-xs text-[#ff7eb3] uppercase tracking-wider font-bold">Total Net Salon Payout</span>
          <div class="mt-2 text-3xl font-black font-heading text-[#ff2a85] tracking-tight" id="summaryNetPayout">₹0</div>
          <span class="text-[11px] text-gray-400 mt-1 block">Green Trends Kothapet monthly payout</span>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- VIEW 3: INCENTIVE & TARGET TRACKER (%)     -->
    <!-- ========================================== -->
    <section id="view-incentives" class="view-panel hidden space-y-6">
      
      <!-- Incentive Top Banner - Ultra-Luxe -->
      <div class="bg-gradient-to-r from-[#0d0d18] via-[#090912] to-[#0d0d18] p-6 rounded-3xl border border-[#222238] shadow-2xl shadow-black/80 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-[#ff2a85] to-purple-500 p-0.5 shadow-lg shadow-purple-500/20 flex-shrink-0">
            <div class="w-full h-full bg-[#090912] rounded-[14px] flex items-center justify-center">
              <i class="fa-solid fa-trophy text-[#ff7eb3] text-xl"></i>
            </div>
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-2.5">
              <h1 class="text-2xl font-black font-heading text-white tracking-tight">
                Percentage-Based Incentive Tracker
              </h1>
              <span class="text-[10px] font-bold px-3 py-1 rounded-full bg-[#ff2a85]/20 text-[#ff7eb3] border border-[#ff2a85]/40 tracking-wider uppercase">
                Active Commission Rules
              </span>
            </div>
            <p class="text-xs text-gray-400 mt-1 font-medium">
              Kalyan Manager gets <strong class="text-white">1% on total salon revenue</strong> (₹6,00,000 target). Stylists get <strong class="text-white">5% on services</strong> (5x salary target) and <strong class="text-white">5% / 8% tiered on products</strong>.
            </p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <button onclick="resetAllSalesAndIncentivesToZero(this)"
            class="px-4 py-2.5 rounded-2xl text-xs font-bold bg-purple-950/40 hover:bg-purple-900/60 text-purple-200 border border-purple-700/50 transition-all flex items-center gap-2 shadow-lg shadow-purple-950/40 cursor-pointer">
            <i class="fa-solid fa-coins text-[#ff7eb3]"></i>
            <span>Reset All Sales & Incentives to ₹0</span>
          </button>
        </div>
      </div>

      <!-- Live Salon Revenue & Incentives Summary Highlights -->
      <div id="incentivesSummaryHighlights" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Dynamically rendered by JS -->
      </div>

      <!-- Live Stylist Leaderboard & Performance Badges Showcase -->
      <div id="stylistLeaderboardContainer" class="bg-gradient-to-r from-[#0d0d18] via-[#090912] to-[#0d0d18] rounded-3xl border border-[#222238] p-5 sm:p-6 shadow-2xl space-y-5">
        <!-- Rendered dynamically by JS: Podium, rankings & awards -->
      </div>

      <!-- Staff Progress Grid -->
      <div id="incentivesProgressContainer" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Rendered dynamically by JS -->
      </div>
    </section>

    <!-- ========================================== -->
    <!-- VIEW 5: SALON PETTY CASH & DAILY EXPENSES  -->
    <!-- ========================================== -->
    <section id="view-expenses" class="view-panel hidden space-y-6">
      
      <div class="bg-[#0d0d15] p-6 rounded-3xl border border-[#1f1f30] shadow-2xl space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#1f1f30] pb-4">
          <div class="flex items-center gap-3.5">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-amber-500 to-orange-500 p-0.5 shadow-lg shadow-orange-500/20 flex items-center justify-center shrink-0">
              <div class="w-full h-full bg-[#0d0d15] rounded-[14px] flex items-center justify-center">
                <i class="fa-solid fa-receipt text-amber-400 text-lg"></i>
              </div>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h2 class="font-syne font-extrabold text-xl text-white">Salon Petty Cash & Daily Expense Tracker</h2>
                <span class="text-[10px] font-bold font-mono px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30">BRANCH LEDGER</span>
              </div>
              <p class="text-xs text-gray-400 mt-0.5">Track daily operational cash payouts (towel laundry, drinking water cans, client refreshments, cleaning supplies).</p>
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-2.5">
            <button type="button" onclick="exportExpensesCSV()" class="px-3.5 py-2.5 rounded-2xl text-xs font-bold bg-[#141424] hover:bg-[#1e1e34] text-gray-300 hover:text-white border border-[#24243a] flex items-center gap-2 transition-all cursor-pointer">
              <i class="fa-solid fa-file-csv text-emerald-400"></i>
              <span>Export CSV</span>
            </button>
            <button type="button" onclick="openAddExpenseModal()" class="px-5 py-2.5 rounded-2xl text-xs font-bold bg-gradient-to-r from-amber-500 to-orange-500 hover:brightness-110 text-white shadow-lg shadow-amber-500/30 flex items-center gap-2 transition-all cursor-pointer">
              <i class="fa-solid fa-plus"></i>
              <span>Add Daily Expense</span>
            </button>
          </div>
        </div>

        <!-- Summary KPI Cards for Expenses -->
        <div id="expenseKpis" class="grid grid-cols-2 sm:grid-cols-4 gap-3.5">
          <!-- Dynamically rendered by JS -->
        </div>

        <!-- Expense Ledger Table -->
        <div class="overflow-x-auto touch-scroll rounded-2xl border border-[#1e1e30]">
          <table class="w-full text-left border-collapse text-xs whitespace-nowrap">
            <thead>
              <tr class="bg-[#12121e] text-gray-400 border-b border-[#1f1f30] uppercase tracking-wider font-bold text-[10px]">
                <th class="py-3 px-3">Date</th>
                <th class="py-3 px-3">Category</th>
                <th class="py-3 px-3">Description / Note</th>
                <th class="py-3 px-3">Payment Method</th>
                <th class="py-3 px-3 text-right">Amount (₹)</th>
                <th class="py-3 px-3 text-center">Action</th>
              </tr>
            </thead>
            <tbody id="expenseTableBody" class="divide-y divide-[#171726] text-gray-200">
              <!-- Dynamically rendered by JS -->
            </tbody>
            <tfoot id="expenseTableFoot" class="bg-[#10101b] font-bold text-white border-t-2 border-[#242438]">
              <!-- Totals row rendered by JS -->
            </tfoot>
          </table>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- VIEW 6: SCHEDULE ROSTER SCANNER (ROSTER)   -->
    <!-- ========================================== -->
    <section id="view-roster" class="view-panel hidden space-y-6">
      
      <div class="bg-[#0d0d15] p-6 rounded-3xl border border-[#1f1f30] shadow-2xl flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#ff2a85] to-[#ff7eb3] text-white flex items-center justify-center text-sm shadow-md shadow-[#ff2a85]/30">
              <i class="fa-solid fa-camera"></i>
            </span>
            <h1 class="text-2xl font-syne font-extrabold text-white">Daily Roster Image Scanner</h1>
          </div>
          <p class="text-xs text-gray-400 mt-1 font-medium">
            Paste an image directly with <strong class="text-white">Ctrl + V</strong> or upload the schedule screenshot. Strictly matches names in the roster.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <div class="flex items-center bg-[#131320] rounded-2xl border border-[#252538] px-3.5 py-2">
            <span class="text-gray-400 text-xs font-semibold mr-2">Target Date:</span>
            <input type="date" id="rosterTargetDate" class="bg-transparent text-white text-xs font-bold focus:outline-none cursor-pointer font-mono">
          </div>

          <button onclick="loadSampleUploadedRoster()" 
            class="px-4 py-2.5 rounded-2xl text-xs font-bold bg-[#1b1526] hover:bg-[#281b3a] text-[#ff7eb3] border border-[#ff2a85]/40 transition-all flex items-center gap-2">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            <span>Load Sample Image (26-09-2026)</span>
          </button>
        </div>
      </div>

      <!-- Main Scanner Grid: Left Image Paste / Upload Box | Right Detected Staff Preview -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Left Box: Multi-Image Paste (Ctrl+V) & File Upload Gallery -->
        <div class="bg-[#0d0d18] rounded-3xl border border-[#222238] p-6 shadow-2xl space-y-4">
          
          <div class="flex items-center justify-between">
            <div>
              <h3 class="font-heading font-bold text-base text-white flex items-center gap-2">
                <span>Roster Schedule Photos</span>
                <span id="rosterImageCountBadge" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[#ff2a85]/20 text-[#ff7eb3] border border-[#ff2a85]/40 font-mono">
                  0 Pics
                </span>
              </h3>
              <p class="text-[11px] text-gray-400 mt-0.5">Paste multiple screenshots (<kbd class="px-1.5 py-0.5 rounded bg-[#1c1c2e] text-[#ff7eb3] font-mono text-[10px]">Ctrl+V</kbd>) - 1, 2, 3+ photos supported!</p>
            </div>
            <button id="clearAllImagesBtn" onclick="clearAllRosterImages()" class="hidden text-xs text-rose-400 hover:text-rose-300 font-bold transition-colors cursor-pointer">
              <i class="fa-solid fa-trash-can mr-1"></i>Clear All
            </button>
          </div>

          <!-- Hidden Multi-file Input -->
          <input type="file" id="rosterFileInput" accept="image/*" multiple class="hidden" onchange="handleRosterMultipleImages(event)">

          <!-- Drop & Paste Multi-Image Interactive Box -->
          <div id="dropZone"
            class="border-2 border-dashed border-[#2b2b42] hover:border-[#ff2a85] rounded-3xl p-5 text-center transition-all bg-[#080811] hover:bg-[#0f0f1c] relative min-h-[180px] flex flex-col justify-center items-center">
            
            <!-- Default Prompt when 0 images -->
            <div id="uploadPrompt" onclick="document.getElementById('rosterFileInput').click()" class="space-y-3 py-4 cursor-pointer w-full">
              <div class="w-16 h-16 rounded-2xl bg-[#ff2a85]/10 text-[#ff2a85] flex items-center justify-center mx-auto text-3xl group-hover:scale-110 transition-transform shadow-lg shadow-[#ff2a85]/20">
                <i class="fa-solid fa-images"></i>
              </div>
              <div>
                <p class="text-sm font-bold text-white">Press <kbd class="px-2 py-0.5 rounded bg-[#1e1e32] border border-[#33334e] text-[#ff7eb3] font-mono">Ctrl + V</kbd> to Paste Any Schedule Pic</p>
                <p class="text-xs text-gray-400 mt-1.5">You can paste 1, 2, 3 or more photos! Click here to browse</p>
              </div>
            </div>

            <!-- Multi-Image Thumbnails Gallery Grid (Visible when images added) -->
            <div id="rosterGalleryContainer" class="hidden w-full space-y-3">
              <div id="rosterGalleryGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-3 w-full">
                <!-- Dynamically populated thumbnails -->
              </div>
              <div class="flex items-center justify-center gap-2 pt-2">
                <button type="button" onclick="document.getElementById('rosterFileInput').click()" 
                  class="text-xs font-bold text-[#ff7eb3] hover:text-white bg-[#151526] hover:bg-[#202038] border border-[#2b2b44] px-3.5 py-1.5 rounded-xl transition-all flex items-center gap-1.5 cursor-pointer">
                  <i class="fa-solid fa-plus text-[10px]"></i> Add Another Pic
                </button>
                <span class="text-[11px] text-gray-500">or press <kbd class="text-gray-300 font-mono">Ctrl+V</kbd></span>
              </div>
            </div>
          </div>

          <!-- Quick Action Buttons -->
          <div class="flex items-center gap-3">
            <button type="button" onclick="pasteImageFromClipboard()" 
              class="flex-1 py-3 rounded-2xl text-xs font-bold bg-[#141424] hover:bg-[#1e1e36] text-white border border-[#26263e] transition-all flex items-center justify-center gap-2 cursor-pointer shadow-md">
              <i class="fa-solid fa-paste text-[#ff2a85]"></i>
              <span>Paste Image (Ctrl+V)</span>
            </button>
            <button type="button" onclick="document.getElementById('rosterFileInput').click()" 
              class="flex-1 py-3 rounded-2xl text-xs font-bold bg-[#141424] hover:bg-[#1e1e36] text-white border border-[#26263e] transition-all flex items-center justify-center gap-2 cursor-pointer shadow-md">
              <i class="fa-solid fa-folder-open text-purple-400"></i>
              <span>Browse Multiple Images</span>
            </button>
          </div>

          <!-- OCR Progress Bar -->
          <div id="ocrProgressBox" class="hidden space-y-1.5 pt-2">
            <div class="flex items-center justify-between text-xs text-gray-300">
              <span id="ocrStatusText">Enhancing image contrast & reading schedule...</span>
              <span id="ocrPercent" class="font-mono text-[#ff7eb3] font-bold">0%</span>
            </div>
            <div class="w-full bg-[#141422] h-2.5 rounded-full overflow-hidden">
              <div id="ocrProgressBar" class="h-full bg-gradient-to-r from-purple-500 via-[#ff2a85] to-emerald-400 transition-all duration-300" style="width: 0%"></div>
            </div>
          </div>

          <!-- Main Scan Button -->
          <button id="scanRosterBtn" onclick="scanUploadedRoster()" 
            class="w-full py-3.5 rounded-2xl text-xs font-extrabold bg-gradient-to-r from-[#ff2a85] to-[#ff5c99] hover:brightness-110 text-white shadow-xl shadow-[#ff2a85]/30 transition-all flex items-center justify-center gap-2 cursor-pointer">
            <i class="fa-solid fa-bolt"></i>
            <span id="scanBtnLabel">Scan Schedule Image with AI</span>
          </button>
        </div>

        <!-- Right Box: Extracted Roster Preview (Strictly detected staff only) -->
        <div class="bg-[#0d0d15] rounded-3xl border border-[#1f1f30] p-6 shadow-2xl flex flex-col justify-between space-y-4">
          <div>
            <div class="flex items-center justify-between border-b border-[#1b1b2a] pb-3">
              <div>
                <h3 class="font-heading font-bold text-base text-white">Detected Roster Staff</h3>
                <p class="text-xs text-gray-400">Staff not in this roster will remain completely untouched</p>
              </div>
              <div class="flex items-center gap-2">
                <button type="button" onclick="openQuickAddStaffToRoster()" 
                  class="px-2.5 py-1 rounded-xl bg-[#171728] hover:bg-[#222238] text-gray-300 hover:text-white border border-[#2b2b40] text-[11px] font-bold transition-all flex items-center gap-1.5 cursor-pointer" title="Manually add any staff to this roster">
                  <i class="fa-solid fa-plus text-[#ff2a85] text-[10px]"></i>
                  <span>Add Staff</span>
                </button>
                <span id="detectedCountBadge" class="px-3 py-1 rounded-full bg-[#ff2a85]/20 text-[#ff7eb3] font-bold font-mono text-xs">
                  0 Staff Found
                </span>
              </div>
            </div>

            <!-- Parsed Staff List (Only staff present in roster!) -->
            <div id="parsedRosterList" class="space-y-3 max-h-[380px] overflow-y-auto pr-1 mt-4">
              <div class="text-center py-14 text-xs text-gray-500">
                <i class="fa-solid fa-image text-3xl mb-2 text-gray-600 block"></i>
                <span>Paste a schedule image with Ctrl+V or upload to scan.</span>
              </div>
            </div>
          </div>

          <!-- Bottom Apply Button -->
          <div class="pt-3 border-t border-[#1a1a28]">
            <button onclick="applyRosterToAttendance()" 
              class="w-full py-3.5 rounded-2xl text-xs font-extrabold bg-emerald-500 hover:bg-emerald-400 text-black shadow-xl shadow-emerald-500/20 transition-all flex items-center justify-center gap-2">
              <i class="fa-solid fa-check-double"></i>
              <span>Apply Detected Shifts to Attendance</span>
            </button>
            <p class="text-[10px] text-gray-500 text-center mt-2">
              * Only staff identified in this roster image will be updated.
            </p>
          </div>
        </div>

      </div>

    </section>

    <!-- ========================================== -->
    <!-- VIEW 5: ADMIN MANAGEMENT PANEL             -->
    <!-- (Completely hidden from normal UI, only    -->
    <!-- accessible when user edits URL to #admin)  -->
    <!-- ========================================== -->
    <section id="view-admin" class="view-panel hidden space-y-6">
      
      <!-- Admin Top Banner -->
      <div class="bg-gradient-to-r from-[#170a1a] via-[#0d0d15] to-[#170a1a] p-6 rounded-3xl border border-[#ff2a85]/40 shadow-2xl flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full bg-[#ff2a85] text-black font-extrabold text-[10px] tracking-wider uppercase">
              CONFIDENTIAL ADMIN PORTAL
            </span>
            <h1 class="text-2xl font-syne font-extrabold text-white">Green Trends Owner Master Controls</h1>
          </div>
          <p class="text-xs text-gray-300 mt-1">
            Configure base salaries, food allowances, Kalyan's salon revenue target, individual percentage commissions, and OT settings.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <button onclick="navigateTo('attendance')" 
            class="px-4 py-2.5 rounded-2xl text-xs font-bold bg-[#161624] hover:bg-[#202034] text-white border border-[#252538] transition-all flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Return to Staff Portal</span>
          </button>
          <button onclick="openAddStaffModal()" 
            class="px-5 py-2.5 rounded-2xl text-xs font-bold bg-gradient-to-r from-[#ff2a85] to-[#ff5c99] hover:brightness-110 text-white shadow-xl shadow-[#ff2a85]/30 transition-all flex items-center gap-2">
            <i class="fa-solid fa-user-plus"></i>
            <span>Add New Staff</span>
          </button>
        </div>
      </div>

      <!-- Admin Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Left: Staff Salaries & Percentage Rules (2 cols) -->
        <div class="lg:col-span-2 bg-[#0d0d15] rounded-3xl border border-[#1f1f30] p-6 shadow-2xl space-y-4">
          <div class="flex items-center justify-between border-b border-[#1f1f30] pb-4">
            <div>
              <h2 class="font-syne font-bold text-lg text-white">Staff Roster & Commission Rules</h2>
              <p class="text-xs text-gray-400">Configure base salary, food allowance, and individual targets/rates.</p>
            </div>
            <button onclick="saveAllStaffEdits()" class="px-4 py-2 rounded-xl text-xs font-bold bg-[#ff2a85] hover:bg-[#ff4d9a] text-white transition-all shadow-lg shadow-[#ff2a85]/30">
              Save All Changes
            </button>
          </div>

          <div id="adminStaffList" class="space-y-4">
            <!-- Rendered dynamically by JS -->
          </div>
        </div>

        <!-- Right: Salon Monthly Target & Rules (1 col) -->
        <div class="space-y-6">
          
          <!-- Kalyan Salon Target Setting -->
          <div class="bg-[#0d0d15] rounded-3xl border border-[#1f1f30] p-6 shadow-2xl space-y-4">
            <h2 class="font-syne font-bold text-base text-white flex items-center gap-2">
              <i class="fa-solid fa-crown text-[#ff7eb3]"></i>
              <span>Kalyan Manager Commission</span>
            </h2>
            
            <div class="space-y-3 text-xs">
              <div>
                <label class="block text-gray-400 mb-1">Monthly Salon Service Revenue Target (₹)</label>
                <input type="number" id="adminSalonTarget" value="600000" 
                  class="w-full bg-[#141420] border border-[#252538] rounded-xl px-3 py-2 text-white font-mono font-bold focus:outline-none focus:border-[#ff2a85]">
                <span class="text-[10px] text-gray-500">Kalyan gets 1% on total salon service revenue when this target is reached.</span>
              </div>

              <div>
                <label class="block text-gray-400 mb-1">Manager Commission (%)</label>
                <input type="number" id="adminManagerRate" value="1" min="0" max="10" 
                  class="w-full bg-[#141420] border border-[#252538] rounded-xl px-3 py-2 text-white font-mono font-bold focus:outline-none focus:border-[#ff2a85]">
              </div>

              <button onclick="saveSalonManagerTarget()" 
                class="w-full py-2.5 rounded-xl text-xs font-bold bg-[#1b1b2a] hover:bg-[#252538] text-white border border-[#2f2f44] transition-all">
                Update Manager Rule
              </button>
            </div>
          </div>

          <!-- Shift & OT Settings -->
          <div class="bg-[#0d0d15] rounded-3xl border border-[#1f1f30] p-6 shadow-2xl space-y-4">
            <h2 class="font-syne font-bold text-base text-white flex items-center gap-2">
              <i class="fa-solid fa-clock text-[#ff2a85]"></i>
              <span>Shift & Overtime Rules</span>
            </h2>
            
            <div class="space-y-3 text-xs">
              <div>
                <label class="block text-gray-400 mb-1">Standard Daily Shift (Hours)</label>
                <input type="number" id="adminShiftHours" value="9" min="1" max="18" 
                  class="w-full bg-[#141420] border border-[#252538] rounded-xl px-3 py-2 text-white font-semibold focus:outline-none focus:border-[#ff2a85]">
                <span class="text-[10px] text-gray-500">Shortfall under 9h cuts from earned OT hours!</span>
              </div>

              <div>
                <label class="block text-gray-400 mb-1">OT Grace Threshold (Minutes)</label>
                <input type="number" id="adminOtThreshold" value="45" min="0" max="120" 
                  class="w-full bg-[#141420] border border-[#252538] rounded-xl px-3 py-2 text-white font-semibold focus:outline-none focus:border-[#ff2a85]">
                <span class="text-[10px] text-gray-500">OT starts adding ONLY after 45 extra minutes</span>
              </div>

              <div>
                <label class="block text-gray-400 mb-1">Overtime Rate (₹ per Hour)</label>
                <input type="number" id="adminOtRate" value="50" min="0" 
                  class="w-full bg-[#141420] border border-[#252538] rounded-xl px-3 py-2 text-white font-semibold focus:outline-none focus:border-[#ff2a85]">
              </div>

              <button onclick="saveAdminShiftRules()" 
                class="w-full py-2.5 rounded-xl text-xs font-bold bg-[#1b1b2a] hover:bg-[#252538] text-white border border-[#2f2f44] transition-all">
                Update Shift Rules
              </button>
            </div>
          </div>

          <!-- Firebase Real-Time Cloud Sync (100% Free) -->
          <div class="bg-[#0d0d15] rounded-3xl border border-[#ff2a85]/40 p-6 shadow-2xl space-y-3.5 relative overflow-hidden">
            <div class="flex items-center justify-between">
              <h2 class="font-syne font-bold text-base text-white flex items-center gap-2">
                <i class="fa-solid fa-cloud-bolt text-[#ff2a85]"></i>
                <span>Firebase Cloud Sync</span>
              </h2>
              <span id="cloudStatusBadgeAdmin" class="text-[10px] font-bold font-mono px-2.5 py-1 rounded-full bg-amber-500/15 text-amber-400 border border-amber-500/30 flex items-center gap-1.5">
                <span id="cloudStatusDotAdmin" class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                <span id="cloudStatusTextAdmin">Local Storage</span>
              </span>
            </div>

            <p class="text-[11px] text-gray-400 leading-relaxed">
              100% Free automatic real-time sync with Google Firebase. Syncs attendance, OT, and sales between your phone, tablet, and laptop.
            </p>

            <!-- Unconnected Setup View -->
            <div id="firebaseSetupSection" class="space-y-3 pt-1">
              <div>
                <div class="flex items-center justify-between mb-1">
                  <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-300">
                    Firebase Config Code
                  </label>
                  <button type="button" onclick="openFirebaseHelpModal()" class="text-[11px] text-[#ff7eb3] hover:underline flex items-center gap-1">
                    <i class="fa-solid fa-circle-question"></i>
                    <span>How to get free key?</span>
                  </button>
                </div>
                <textarea id="firebaseConfigInput" rows="3" placeholder='Paste your firebaseConfig code here, e.g.:
const firebaseConfig = {
  apiKey: "AIzaSy...",
  projectId: "green-trends-kothapet",
  ...
};' class="w-full bg-[#141420] border border-[#252538] rounded-xl px-3 py-2 text-white font-mono text-[11px] focus:outline-none focus:border-[#ff2a85]"></textarea>
              </div>

              <div class="flex items-center gap-2">
                <button type="button" onclick="connectFirebaseCloud()" 
                  class="flex-1 py-2.5 rounded-xl text-xs font-bold bg-gradient-to-r from-[#ff2a85] to-[#ff5c99] hover:brightness-110 text-white transition-all shadow-md shadow-[#ff2a85]/20 flex items-center justify-center gap-1.5 cursor-pointer">
                  <i class="fa-solid fa-bolt"></i>
                  <span>Connect & Push Local Data</span>
                </button>
              </div>
            </div>

            <!-- Connected View -->
            <div id="firebaseConnectedSection" class="hidden space-y-3 pt-1">
              <div class="p-3 bg-[#0d1614] rounded-2xl border border-emerald-500/30 text-xs text-emerald-300 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  <div>
                    <strong class="block text-white font-bold text-xs" id="connectedProjectName">Connected to Firestore</strong>
                    <span class="text-[10px] text-emerald-400 font-mono" id="lastCloudSyncTime">Live 2-Way Sync Active</span>
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-2 text-xs">
                <button type="button" onclick="pushLocalDataToFirestore(true)" 
                  class="py-2.5 px-2 rounded-xl font-bold bg-[#141424] hover:bg-[#202038] text-white border border-[#282844] flex items-center justify-center gap-1.5 cursor-pointer" title="Upload local attendance and staff to Cloud">
                  <i class="fa-solid fa-cloud-arrow-up text-[#ff7eb3]"></i>
                  <span>Push to Cloud</span>
                </button>
                <button type="button" onclick="pullDataFromFirestore(true)" 
                  class="py-2.5 px-2 rounded-xl font-bold bg-[#141424] hover:bg-[#202038] text-white border border-[#282844] flex items-center justify-center gap-1.5 cursor-pointer" title="Download latest data from Cloud">
                  <i class="fa-solid fa-cloud-arrow-down text-emerald-400"></i>
                  <span>Pull from Cloud</span>
                </button>
              </div>

              <button type="button" onclick="disconnectFirebaseCloud()" 
                class="w-full py-1.5 rounded-xl text-[11px] font-semibold text-rose-400 hover:text-rose-300 hover:bg-rose-500/10 transition-colors">
                Disconnect Firebase (Revert to Local)
              </button>
            </div>
          </div>

          <!-- Data Backup & Reset -->
          <div class="bg-[#0d0d15] rounded-3xl border border-[#1f1f30] p-6 shadow-2xl space-y-3">
            <h2 class="font-syne font-bold text-base text-white flex items-center gap-2">
              <i class="fa-solid fa-database text-gray-400"></i>
              <span>Data Backup & Restore</span>
            </h2>
            
            <div class="flex flex-col gap-2 pt-2">
              <button onclick="backupSystemData()" 
                class="w-full py-2.5 rounded-xl text-xs font-bold bg-[#141420] hover:bg-[#1f1f30] text-white border border-[#252538] transition-all flex items-center justify-center gap-2">
                <i class="fa-solid fa-download"></i>
                <span>Download Backup (JSON)</span>
              </button>

              <button onclick="document.getElementById('restoreFileInput').click()" 
                class="w-full py-2.5 rounded-xl text-xs font-bold bg-[#141420] hover:bg-[#1f1f30] text-white border border-[#252538] transition-all flex items-center justify-center gap-2">
                <i class="fa-solid fa-upload"></i>
                <span>Restore from Backup</span>
              </button>
              <input type="file" id="restoreFileInput" onchange="restoreSystemData(event)" accept=".json" class="hidden">

              <button onclick="syncRealSeptemberAttendanceData()" 
                class="w-full py-2.5 rounded-xl text-xs font-bold bg-[#141424] hover:bg-[#202038] text-purple-300 border border-purple-800/40 transition-all flex items-center justify-center gap-2 cursor-pointer" title="Load accurate WhatsApp login/logout attendance records for Sep 1-26">
                <i class="fa-solid fa-rotate text-[#ff7eb3]"></i>
                <span>Re-Sync WhatsApp Chat Check-in Data (Sep 1–26)</span>
              </button>

              <button onclick="resetAllSalesAndIncentivesToZero(this)" 
                class="w-full py-2.5 rounded-xl text-xs font-bold bg-purple-950/30 hover:bg-purple-900/50 text-purple-200 border border-purple-800/40 transition-all flex items-center justify-center gap-2 cursor-pointer">
                <i class="fa-solid fa-coins text-[#ff7eb3]"></i>
                <span>Reset All Sales & Incentives to ₹0</span>
              </button>

              <button onclick="clearAllAttendanceDataToZero(this)" 
                class="w-full py-2.5 rounded-xl text-xs font-bold bg-amber-950/30 hover:bg-amber-900/50 text-amber-200 border border-amber-800/40 transition-all flex items-center justify-center gap-2 cursor-pointer">
                <i class="fa-solid fa-calendar-xmark text-amber-400"></i>
                <span>Clear All Attendance Records (Clean Slate)</span>
              </button>

              <button onclick="confirmResetDefaults()" 
                class="w-full py-2.5 rounded-xl text-xs font-bold bg-rose-950/30 hover:bg-rose-900/40 text-rose-300 border border-rose-800/40 transition-all flex items-center justify-center gap-2">
                <i class="fa-solid fa-rotate-left"></i>
                <span>Reset to Factory Defaults</span>
              </button>
            </div>
          </div>

          <!-- Portal Security & Login Credentials -->
          <div class="bg-[#0d0d15] rounded-3xl border border-[#ff2a85]/30 p-6 shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-[#1f1f32] pb-3">
              <h2 class="font-syne font-bold text-base text-white flex items-center gap-2">
                <i class="fa-solid fa-shield-halved text-[#ff2a85]"></i>
                <span>Portal Login Credentials</span>
              </h2>
              <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">2 ACTIVE ACCOUNTS</span>
            </div>
            
            <div class="space-y-4 text-xs">
              <!-- Account 1: Owner Account -->
              <div class="p-3.5 bg-[#121220] rounded-2xl border border-[#222238] space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-white flex items-center gap-1.5">
                    <i class="fa-solid fa-crown text-amber-400"></i>
                    <span>Owner & Master Administrator</span>
                  </span>
                  <span class="text-[9px] px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 font-bold border border-amber-500/30">OWNER</span>
                </div>
                <div>
                  <label class="block text-gray-400 mb-1">Username / Email</label>
                  <input type="text" id="adminAuthUsername" value="kancherlavatsalsai@gmial.com" 
                    class="w-full bg-[#181828] border border-[#2b2b42] rounded-xl px-3 py-2 text-white font-semibold focus:outline-none focus:border-[#ff2a85]">
                </div>
                <div>
                  <label class="block text-gray-400 mb-1">Change Owner Password</label>
                  <input type="text" id="adminAuthPassword" placeholder="Enter new password to change"
                    class="w-full bg-[#181828] border border-[#2b2b42] rounded-xl px-3 py-2 text-white font-semibold focus:outline-none focus:border-[#ff2a85]">
                </div>
              </div>

              <!-- Account 2: Manager Account -->
              <div class="p-3.5 bg-[#121220] rounded-2xl border border-[#222238] space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-white flex items-center gap-1.5">
                    <i class="fa-solid fa-user-tie text-purple-400"></i>
                    <span>Salon Manager Account</span>
                  </span>
                  <span class="text-[9px] px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 font-bold border border-purple-500/30">MANAGER</span>
                </div>
                <p class="text-[11px] text-gray-400">Authorized for Admin Controls, Timesheet, Kiosk, Petty Cash & Operations.</p>
                <div>
                  <label class="block text-gray-400 mb-1">Username / Email</label>
                  <input type="text" id="adminManagerUsername" value="Greentrendskothapet@gmail.com" 
                    class="w-full bg-[#181828] border border-[#2b2b42] rounded-xl px-3 py-2 text-white font-semibold focus:outline-none focus:border-[#ff2a85]">
                </div>
                <div>
                  <label class="block text-gray-400 mb-1">Change Manager Password</label>
                  <input type="text" id="adminManagerPassword" placeholder="Enter new password to change"
                    class="w-full bg-[#181828] border border-[#2b2b42] rounded-xl px-3 py-2 text-white font-semibold focus:outline-none focus:border-[#ff2a85]">
                </div>
              </div>

              <button type="button" onclick="saveAdminCredentials()" 
                class="w-full py-2.5 rounded-xl text-xs font-bold bg-[#ff2a85] hover:bg-[#ff4d9a] text-white shadow-lg shadow-[#ff2a85]/25 transition-all cursor-pointer">
                Update Login Credentials
              </button>
            </div>
          </div>

        </div>
      </div>

    </section>

  </main>

  <!-- ========================================== -->
  <!-- MODAL: PAY SLIP VOUCHER (PRINTABLE)        -->
  <!-- ========================================== -->
  <div id="paySlipModal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden flex items-center justify-center p-4 overflow-y-auto">
    <div class="relative w-full max-w-2xl bg-[#0c0c14] border border-[#ff2a85]/40 rounded-3xl p-6 sm:p-8 shadow-2xl text-white my-8">
      
      <button onclick="closePaySlipModal()" class="absolute top-5 right-5 text-gray-400 hover:text-white w-8 h-8 rounded-full bg-[#181826] flex items-center justify-center">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <div id="paySlipPrintArea" class="space-y-6">
        
        <!-- Header -->
        <div class="border-b border-[#202032] pb-5 flex items-start justify-between">
          <div>
            <div class="flex items-center gap-2.5">
              <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#ff2a85] to-[#ff7eb3] text-white flex items-center justify-center text-sm shadow-md shadow-[#ff2a85]/30">
                <i class="fa-solid fa-scissors"></i>
              </span>
              <h2 class="font-syne font-extrabold text-2xl text-white tracking-wider">GREEN TRENDS KOTHAPET</h2>
            </div>
            <p class="text-xs text-gray-400 mt-1">Official Monthly Salary Slip & Commission Voucher</p>
          </div>
          <div class="text-right">
            <span class="text-xs px-3 py-1 rounded-full bg-[#ff2a85]/20 text-[#ff7eb3] font-bold font-mono border border-[#ff2a85]/30" id="psMonthYear">
              SEP 2026
            </span>
            <p class="text-[10px] text-gray-500 mt-1" id="psGeneratedDate">Date: 26 Sep 2026</p>
          </div>
        </div>

        <!-- Staff Profile Info Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 bg-[#11111c] p-4 rounded-2xl border border-[#202032] text-xs">
          <div>
            <span class="text-gray-400 block text-[10px] uppercase font-semibold">Staff Name</span>
            <strong class="text-white text-sm" id="psStaffName">KALYAN</strong>
          </div>
          <div>
            <span class="text-gray-400 block text-[10px] uppercase font-semibold">Role / Category</span>
            <span class="text-gray-200 font-medium" id="psStaffRole">Salon Manager</span>
          </div>
          <div>
            <span class="text-gray-400 block text-[10px] uppercase font-semibold">Month Days</span>
            <span class="text-gray-200 font-medium" id="psMonthDays">30 Days</span>
          </div>
          <div>
            <span class="text-gray-400 block text-[10px] uppercase font-semibold">Daily Rate</span>
            <span class="text-[#ff7eb3] font-bold font-mono" id="psPerDayRate">₹833.33</span>
          </div>
        </div>

        <!-- Attendance & Net OT Stats -->
        <div class="grid grid-cols-3 gap-2.5 text-center text-xs">
          <div class="p-3 bg-[#0d1614] border border-emerald-900/40 rounded-2xl">
            <span class="text-gray-400 block text-[10px] uppercase font-semibold">Days Present</span>
            <strong class="text-emerald-400 text-sm" id="psDaysPresent">22 Days</strong>
          </div>
          <div class="p-3 bg-[#111222] border border-indigo-900/40 rounded-2xl">
            <span class="text-gray-400 block text-[10px] uppercase font-semibold">Weekly Offs</span>
            <strong class="text-indigo-300 text-sm" id="psWeeklyOffs">4 Days</strong>
          </div>
          <div class="p-3 bg-[#1c0d12] border border-rose-900/40 rounded-2xl">
            <span class="text-gray-400 block text-[10px] uppercase font-semibold">Leaves (Cut)</span>
            <strong class="text-rose-400 text-sm" id="psUnpaidLeaves">1</strong>
          </div>
        </div>

        <!-- Earnings vs Deductions Table -->
        <div class="border border-[#202032] rounded-2xl overflow-hidden text-xs">
          <div class="grid grid-cols-2 bg-[#12121e] border-b border-[#202032] py-2.5 px-4 font-bold uppercase tracking-wider text-gray-400">
            <span>Earnings & Commissions</span>
            <span class="text-right">Deductions</span>
          </div>

          <div class="p-4 grid grid-cols-2 gap-4">
            <!-- Left: Earnings -->
            <div class="space-y-2 border-r border-[#1c1c2c] pr-4">
              <div class="flex justify-between">
                <span class="text-gray-300">Base Salary</span>
                <span class="font-mono text-white font-semibold" id="psBaseSalary">₹25,000</span>
              </div>
              <div class="flex justify-between" id="psFoodRow">
                <span class="text-gray-300">Food Allowance</span>
                <span class="font-mono text-emerald-400 font-semibold" id="psFoodAllowance">₹1,500</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-300">Net OT (<span id="psOtHoursText">0h</span> @ ₹50/h)</span>
                <span class="font-mono text-[#ff7eb3] font-semibold" id="psOtPay">₹0</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-300" id="psServiceIncentiveLabel">Services Commission</span>
                <span class="font-mono text-purple-400 font-semibold" id="psServiceIncentive">₹0</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-300">Products Commission</span>
                <span class="font-mono text-pink-400 font-semibold" id="psProductIncentive">₹0</span>
              </div>
            </div>

            <!-- Right: Deductions -->
            <div class="space-y-2 pl-2">
              <div class="flex justify-between">
                <span class="text-gray-300">Leave Salary Cut</span>
                <span class="font-mono text-rose-400 font-semibold" id="psLeaveDeduction">₹0</span>
              </div>
              <div class="flex justify-between" id="psShortfallRow">
                <span class="text-gray-400">Hours Shortfall (Cut from OT)</span>
                <span class="font-mono text-amber-400" id="psShortfallText">0h</span>
              </div>
              <div class="flex justify-between hidden" id="psAdvanceRow">
                <span class="text-rose-300 font-semibold flex items-center gap-1">
                  <i class="fa-solid fa-hand-holding-dollar text-rose-400"></i> Salary Advance / Loan
                </span>
                <span class="font-mono text-rose-400 font-bold" id="psAdvanceDeduction">-₹0</span>
              </div>
              <p class="text-[10px] text-gray-500 italic mt-2">
                * Daily cut is calculated as Base Salary ÷ Month Days.
              </p>
            </div>
          </div>

          <!-- Total Net Payable Box -->
          <div class="bg-gradient-to-r from-[#170a1a] to-[#0c0c14] p-4 border-t border-[#ff2a85]/40 flex items-center justify-between">
            <div>
              <span class="text-xs text-gray-400 uppercase tracking-wider block">Net Take-Home Salary</span>
              <span class="text-[10px] text-gray-400">Green Trends Kothapet</span>
            </div>
            <div class="text-right">
              <span class="text-2xl sm:text-3xl font-heading font-extrabold text-[#ff2a85] font-mono tracking-tight" id="psNetPayable">₹26,500</span>
            </div>
          </div>
        </div>

        <!-- Signature Lines -->
        <div class="pt-8 grid grid-cols-2 gap-8 text-center text-xs text-gray-400">
          <div>
            <div class="border-t border-[#2e2e44] pt-2 w-3/4 mx-auto"></div>
            <span>Employee Signature</span>
          </div>
          <div>
            <div class="border-t border-[#2e2e44] pt-2 w-3/4 mx-auto"></div>
            <span>Salon Manager / Owner</span>
          </div>
        </div>

      </div>

      <!-- Action buttons -->
      <div class="mt-6 flex items-center justify-end gap-3 pt-4 border-t border-[#202032]">
        <button onclick="closePaySlipModal()" class="px-4 py-2 rounded-xl text-xs font-semibold bg-[#161624] hover:bg-[#202034] text-gray-300">
          Close
        </button>
        <button onclick="printPaySlip()" class="px-5 py-2.5 rounded-xl text-xs font-bold bg-gradient-to-r from-[#ff2a85] to-[#ff5c99] hover:brightness-110 text-white flex items-center gap-2 shadow-lg shadow-[#ff2a85]/30">
          <i class="fa-solid fa-print"></i>
          <span>Print / Save PDF</span>
        </button>
      </div>

    </div>
  </div>

  <!-- ========================================== -->
  <!-- MODAL: ADD / EDIT STAFF MODAL              -->
  <!-- ========================================== -->
  <div id="staffModal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="relative w-full max-w-md bg-[#0c0c14] border border-[#222236] rounded-3xl p-6 shadow-2xl text-white">
      <h3 class="font-syne font-bold text-lg text-white mb-4" id="staffModalTitle">Add New Staff Member</h3>
      
      <form id="staffForm" onsubmit="handleStaffFormSubmit(event)" class="space-y-4 text-xs">
        <input type="hidden" id="staffFormId">
        
        <div>
          <label class="block text-gray-400 mb-1">Staff Full Name</label>
          <input type="text" id="staffFormName" required placeholder="e.g. Rahul Verma"
            class="w-full bg-[#141420] border border-[#252538] rounded-xl px-3 py-2 text-white font-semibold focus:outline-none focus:border-[#ff2a85]">
        </div>

        <div>
          <label class="block text-gray-400 mb-1">Role / Designation</label>
          <input type="text" id="staffFormRole" required placeholder="e.g. Senior Stylist"
            class="w-full bg-[#141420] border border-[#252538] rounded-xl px-3 py-2 text-white font-semibold focus:outline-none focus:border-[#ff2a85]">
        </div>

        <div>
          <label class="block text-gray-400 mb-1">Monthly Base Salary (₹)</label>
          <input type="number" id="staffFormSalary" required min="0" placeholder="e.g. 25000"
            class="w-full bg-[#141420] border border-[#252538] rounded-xl px-3 py-2 text-white font-semibold focus:outline-none focus:border-[#ff2a85]">
        </div>

        <div>
          <label class="block text-gray-400 mb-1">Food Allowance (₹)</label>
          <input type="number" id="staffFormFood" value="0" min="0" placeholder="e.g. 1500"
            class="w-full bg-[#141420] border border-[#252538] rounded-xl px-3 py-2 text-white font-semibold focus:outline-none focus:border-[#ff2a85]">
        </div>

        <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#1f1f30]">
          <button type="button" onclick="closeStaffModal()" class="px-4 py-2 rounded-xl text-xs font-semibold bg-[#141420] text-gray-400 hover:text-white">
            Cancel
          </button>
          <button type="submit" class="px-5 py-2.5 rounded-xl text-xs font-bold bg-[#ff2a85] hover:bg-[#ff4d9a] text-white shadow-lg shadow-[#ff2a85]/30">
            Save Staff Member
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- MODAL: QUICK ADD STAFF TO ROSTER           -->
  <!-- ========================================== -->
  <div id="quickAddRosterModal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="relative w-full max-w-md bg-[#0c0c14] border border-[#222236] rounded-3xl p-6 shadow-2xl text-white">
      <div class="flex items-center justify-between pb-3 border-b border-[#1f1f30] mb-4">
        <div>
          <h3 class="font-syne font-bold text-lg text-white">Add Staff to Roster</h3>
          <p class="text-xs text-gray-400">Select any stylist to manually add or override in scanned roster</p>
        </div>
        <button type="button" onclick="closeQuickAddStaffModal()" class="w-8 h-8 rounded-full bg-[#171726] text-gray-400 hover:text-white flex items-center justify-center">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div id="quickAddStaffList" class="space-y-2.5 max-h-[350px] overflow-y-auto pr-1">
        <!-- Rendered dynamically -->
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-[#1f1f30] mt-4">
        <button type="button" onclick="closeQuickAddStaffModal()" class="px-4 py-2 rounded-xl text-xs font-semibold bg-[#141420] text-gray-400 hover:text-white">
          Done
        </button>
      </div>
    </div>
  </div>

  <!-- Modal: Add Salon Petty Cash Expense -->
  <div id="addExpenseModal" class="hidden fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4">
    <div class="relative w-full max-w-md bg-[#0c0c14] border border-amber-500/40 rounded-3xl p-6 sm:p-7 shadow-2xl text-white">
      <button type="button" onclick="closeAddExpenseModal()" class="absolute top-5 right-5 text-gray-400 hover:text-white w-8 h-8 rounded-full bg-[#181826] flex items-center justify-center cursor-pointer">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <div class="flex items-center gap-3 mb-5">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-amber-500 to-orange-500 p-0.5 flex items-center justify-center shadow-lg shadow-orange-500/30 shrink-0">
          <div class="w-full h-full bg-[#0c0c14] rounded-[14px] flex items-center justify-center">
            <i class="fa-solid fa-receipt text-amber-400"></i>
          </div>
        </div>
        <div>
          <h3 class="font-syne font-bold text-base text-white">Add Salon Expense</h3>
          <p class="text-[11px] text-amber-300 font-mono">Daily Petty Cash Log</p>
        </div>
      </div>

      <form onsubmit="submitAddExpense(event)" class="space-y-4 text-xs">
        <div>
          <label class="block text-gray-300 font-bold mb-1">Expense Date</label>
          <input type="date" id="expenseDateInput" required class="w-full bg-[#141420] border border-[#252538] rounded-xl px-3 py-2.5 text-white font-mono font-bold focus:outline-none focus:border-amber-400">
        </div>

        <div>
          <label class="block text-gray-300 font-bold mb-1">Category</label>
          <select id="expenseCategoryInput" required class="w-full bg-[#141420] border border-[#252538] rounded-xl px-3 py-2.5 text-white font-semibold focus:outline-none focus:border-amber-400">
            <option value="Towel Laundry">🧺 Towel Laundry / Washing</option>
            <option value="Drinking Water">💧 Drinking Water Cans</option>
            <option value="Client Refreshments">☕ Client Refreshments (Tea, Coffee, Biscuits)</option>
            <option value="Cleaning & Housekeeping">🧹 Cleaning & Housekeeping Supplies</option>
            <option value="Salon Maintenance">⚡ Salon Maintenance & Repairs</option>
            <option value="Stationery & Misc">📦 Stationery / Printing / Misc</option>
          </select>
        </div>

        <div>
          <label class="block text-gray-300 font-bold mb-1">Amount (₹)</label>
          <input type="number" min="1" max="100000" id="expenseAmountInput" placeholder="e.g. 350" required class="w-full bg-[#141420] border border-[#252538] rounded-xl px-3 py-2.5 text-white font-mono font-bold focus:outline-none focus:border-amber-400">
        </div>

        <div>
          <label class="block text-gray-300 font-bold mb-1">
            Description / Note <span class="text-gray-500 font-normal text-[11px]">(Optional)</span>
          </label>
          <input type="text" id="expenseNoteInput" placeholder="e.g. Towel laundry, water refill (optional)" class="w-full bg-[#141420] border border-[#252538] rounded-xl px-3 py-2.5 text-white focus:outline-none focus:border-amber-400">
        </div>

        <div>
          <label class="block text-gray-300 font-bold mb-1">Payment Method</label>
          <select id="expensePaidByInput" class="w-full bg-[#141420] border border-[#252538] rounded-xl px-3 py-2.5 text-white font-semibold focus:outline-none focus:border-amber-400">
            <option value="Salon Account">🏪 Salon Account (Cash Drawer / Salon UPI)</option>
            <option value="Owner Account">👑 Owner Account (Direct Transfer)</option>
          </select>
        </div>

        <div class="mt-6 flex items-center justify-end gap-2 pt-3 border-t border-[#1c1c2c]">
          <button type="button" onclick="closeAddExpenseModal()" class="px-4 py-2.5 rounded-xl text-xs font-semibold bg-[#181828] text-gray-300 hover:text-white cursor-pointer">
            Cancel
          </button>
          <button type="submit" class="px-5 py-2.5 rounded-xl text-xs font-bold bg-gradient-to-r from-amber-500 to-orange-500 hover:brightness-110 text-white shadow-lg shadow-amber-500/30 flex items-center gap-1.5 cursor-pointer">
            <i class="fa-solid fa-check"></i>
            <span>Save Expense</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Progressive Web App (PWA) Install Guide Modal -->
  <div id="pwaModal" class="hidden fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4">
    <div class="relative w-full max-w-md bg-[#0c0c14] border border-[#ff2a85]/40 rounded-3xl p-6 sm:p-7 shadow-2xl text-white">
      <button type="button" onclick="closePwaInstallModal()" class="absolute top-5 right-5 text-gray-400 hover:text-white w-8 h-8 rounded-full bg-[#181826] flex items-center justify-center">
        <i class="fa-solid fa-xmark"></i>
      </button>
      
      <div class="flex items-center gap-3 mb-4">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-[#ff2a85] to-[#ff7eb3] p-0.5 flex items-center justify-center shadow-lg shadow-[#ff2a85]/30 shrink-0">
          <img src="icon-192.png" alt="App Icon" class="w-full h-full rounded-[14px] object-cover">
        </div>
        <div>
          <h3 class="font-syne font-bold text-base text-white">Install Green Trends App</h3>
          <p class="text-[11px] text-[#ff7eb3] font-mono">Mobile App Mode (PWA)</p>
        </div>
      </div>

      <p class="text-xs text-gray-300 mb-4 leading-relaxed">
        Install this portal directly onto your Android, iPhone, or PC to launch it in full-screen standalone mode with offline caching.
      </p>

      <div class="space-y-3 text-xs">
        <div id="pwaStepIos" class="p-3.5 rounded-2xl bg-[#12121e] border border-[#222236] transition-all flex items-start gap-3">
          <span class="w-7 h-7 rounded-xl bg-pink-500/20 text-[#ff7eb3] flex items-center justify-center font-bold shrink-0 text-sm">
            <i class="fa-brands fa-apple"></i>
          </span>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-bold text-white block">iPhone / iPad (Safari)</span>
              <span id="badgeIos" class="hidden text-[9px] px-1.5 py-0.5 rounded bg-pink-500/20 text-[#ff7eb3] font-bold">Your Device</span>
            </div>
            <span class="text-gray-300 text-[11px] leading-relaxed block mt-0.5">
              Tap the <i class="fa-solid fa-arrow-up-from-bracket text-sky-400 font-bold"></i> <strong>Share</strong> button at the bottom of Safari, scroll down, then tap <strong>'Add to Home Screen'</strong> <i class="fa-solid fa-square-plus text-[#ff2a85]"></i>.
            </span>
          </div>
        </div>

        <div id="pwaStepAndroid" class="p-3.5 rounded-2xl bg-[#12121e] border border-[#222236] transition-all flex items-start gap-3">
          <span class="w-7 h-7 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold shrink-0 text-sm">
            <i class="fa-brands fa-android"></i>
          </span>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-bold text-white block">Android Phone (Chrome)</span>
              <span id="badgeAndroid" class="hidden text-[9px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-bold">Your Device</span>
            </div>
            <span class="text-gray-300 text-[11px] leading-relaxed block mt-0.5">
              Tap the <i class="fa-solid fa-ellipsis-vertical text-amber-400 font-bold"></i> <strong>Chrome menu</strong> (top-right), then tap <strong>'Install app'</strong> or 'Add to Home screen'.
            </span>
          </div>
        </div>

        <div id="pwaStepDesktop" class="p-3.5 rounded-2xl bg-[#12121e] border border-[#222236] transition-all flex items-start gap-3">
          <span class="w-7 h-7 rounded-xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center font-bold shrink-0 text-sm">
            <i class="fa-solid fa-desktop"></i>
          </span>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-bold text-white block">Windows PC / Mac</span>
              <span id="badgeDesktop" class="hidden text-[9px] px-1.5 py-0.5 rounded bg-indigo-500/20 text-indigo-400 font-bold">Your Device</span>
            </div>
            <span class="text-gray-300 text-[11px] leading-relaxed block mt-0.5">
              Click the <strong>Install</strong> icon <i class="fa-solid fa-download text-indigo-300"></i> in the browser URL address bar to install to desktop.
            </span>
          </div>
        </div>
      </div>

      <div class="mt-5 flex items-center justify-end gap-2">
        <button type="button" onclick="closePwaInstallModal()" class="px-4 py-2.5 rounded-xl text-xs font-semibold bg-[#181828] text-gray-300 hover:text-white cursor-pointer">
          Close
        </button>
        <button type="button" id="pwaDirectInstallBtn" onclick="triggerNativeInstall()" class="px-5 py-2.5 rounded-xl text-xs font-bold bg-gradient-to-r from-[#ff2a85] to-[#ff5c99] text-white shadow-lg shadow-[#ff2a85]/30 hover:brightness-110 flex items-center gap-1.5 cursor-pointer">
          <i class="fa-solid fa-download"></i>
          <span id="pwaDirectInstallText">Install Now</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Firebase 1-Minute Setup Guide Modal -->
  <div id="firebaseHelpModal" class="hidden fixed inset-0 z-50 bg-black/85 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-[#0e0e18] border border-[#ff2a85]/40 rounded-3xl max-w-lg w-full p-6 shadow-2xl space-y-4">
      <div class="flex items-center justify-between border-b border-[#1f1f32] pb-3">
        <div class="flex items-center gap-2.5">
          <span class="w-8 h-8 rounded-xl bg-orange-500/20 text-orange-400 flex items-center justify-center">
            <i class="fa-solid fa-fire text-sm"></i>
          </span>
          <div>
            <h3 class="font-syne font-bold text-white text-base">Free Firebase Setup (3 Steps)</h3>
            <p class="text-[11px] text-gray-400">Takes only 2 minutes — no credit card required!</p>
          </div>
        </div>
        <button type="button" onclick="closeFirebaseHelpModal()" class="w-8 h-8 rounded-full bg-[#181828] text-gray-400 hover:text-white flex items-center justify-center">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="space-y-3.5 text-xs text-gray-300 leading-relaxed max-h-[420px] overflow-y-auto pr-1">
        <!-- Step 1 -->
        <div class="p-3.5 bg-[#131322] rounded-2xl border border-[#232338] space-y-1">
          <span class="text-[#ff7eb3] font-bold text-xs">Step 1: Create Free Project</span>
          <p class="text-gray-400">
            Open <a href="https://console.firebase.google.com" target="_blank" class="text-white underline font-semibold">console.firebase.google.com</a> with your Google account. Click <strong>"Add project"</strong> and enter name: <code class="text-pink-300 bg-black/40 px-1 py-0.5 rounded">green-trends-kothapet</code>. Click Continue until created.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-3.5 bg-[#131322] rounded-2xl border border-[#232338] space-y-1">
          <span class="text-[#ff7eb3] font-bold text-xs">Step 2: Create Firestore Database</span>
          <p class="text-gray-400">
            In your Firebase dashboard, click <strong>"Build"</strong> $\rightarrow$ <strong>"Firestore Database"</strong> $\rightarrow$ click <strong>"Create database"</strong>. Select <strong>"Start in test mode"</strong> (allows free read/write) and click Enable.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="p-3.5 bg-[#131322] rounded-2xl border border-[#232338] space-y-1">
          <span class="text-[#ff7eb3] font-bold text-xs">Step 3: Register Web App & Copy Code</span>
          <p class="text-gray-400">
            Click Project Settings (Gear icon ⚙️) $\rightarrow$ scroll down to "Your apps" $\rightarrow$ click the Web icon <strong>`</>`</strong>. Give it any nickname and click "Register app". Copy the generated <code class="text-pink-300 bg-black/40 px-1 py-0.5 rounded">const firebaseConfig = { ... }</code> snippet and paste it into the Cloud Sync box!
          </p>
        </div>
      </div>

      <div class="flex items-center justify-end gap-2 pt-2 border-t border-[#1f1f32]">
        <a href="https://console.firebase.google.com" target="_blank" class="px-4 py-2 rounded-xl text-xs font-bold bg-[#ff2a85] hover:bg-[#ff4d9a] text-white transition-all flex items-center gap-1.5">
          <span>Open Firebase Console</span>
          <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
        </a>
        <button type="button" onclick="closeFirebaseHelpModal()" class="px-4 py-2 rounded-xl text-xs font-semibold bg-[#161626] text-gray-300 hover:text-white">
          Close
        </button>
      </div>
    </div>
  </div>

  <!-- Modern Native Mobile Bottom Navigation Bar (7 Tabs) -->
  <nav id="mobileBottomNav" class="lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-[#080812]/95 backdrop-blur-xl border-t border-[#1c1c2e] px-1 py-1 safe-bottom shadow-2xl">
    <div id="mobileNavGrid" class="grid grid-cols-7 gap-0.5 text-center w-full max-w-lg mx-auto">
      <button onclick="navigateTo('attendance')" id="mobileNav-attendance" class="py-1 px-0.5 text-[10px] font-bold rounded-xl text-[#ff2a85] bg-[#ff2a85]/15 transition-all cursor-pointer">
        <i class="fa-solid fa-calendar-check block text-sm mb-0.5"></i>
        <span>Attd</span>
      </button>
      <button onclick="navigateTo('kiosk')" id="mobileNav-kiosk" class="py-1 px-0.5 text-[10px] font-bold rounded-xl text-gray-400 hover:text-white transition-all cursor-pointer">
        <i class="fa-solid fa-stopwatch block text-sm mb-0.5"></i>
        <span>Kiosk</span>
      </button>
      <button onclick="navigateTo('payroll')" id="mobileNav-payroll" class="py-1 px-0.5 text-[10px] font-bold rounded-xl text-gray-400 hover:text-white transition-all cursor-pointer">
        <i class="fa-solid fa-file-invoice-dollar block text-sm mb-0.5"></i>
        <span>Pay</span>
      </button>
      <button onclick="navigateTo('incentives')" id="mobileNav-incentives" class="py-1 px-0.5 text-[10px] font-bold rounded-xl text-gray-400 hover:text-white transition-all cursor-pointer">
        <i class="fa-solid fa-trophy block text-sm mb-0.5"></i>
        <span>Incen</span>
      </button>
      <button onclick="navigateTo('expenses')" id="mobileNav-expenses" class="py-1 px-0.5 text-[10px] font-bold rounded-xl text-gray-400 hover:text-white transition-all cursor-pointer">
        <i class="fa-solid fa-receipt block text-sm mb-0.5"></i>
        <span>Cash</span>
      </button>
      <button onclick="navigateTo('roster')" id="mobileNav-roster" class="py-1 px-0.5 text-[10px] font-bold rounded-xl text-gray-400 hover:text-white transition-all cursor-pointer">
        <i class="fa-solid fa-camera block text-sm mb-0.5"></i>
        <span>Roster</span>
      </button>
      <button onclick="navigateTo('admin')" id="mobileNav-admin" class="py-1 px-0.5 text-[10px] font-bold rounded-xl text-gray-400 hover:text-white transition-all cursor-pointer">
        <i class="fa-solid fa-sliders block text-sm mb-0.5"></i>
        <span>Admin</span>
      </button>
    </div>
  </nav>

  <!-- Modal: Kiosk 1-Tap Celebration Notification -->
  <div id="kioskCelebrationModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4" onclick="closeKioskCelebration()">
    <div class="relative w-full max-w-sm bg-[#0c0c16] border border-emerald-500/50 rounded-3xl p-6 sm:p-7 shadow-2xl text-center text-white space-y-4 animate-bounce-once">
      <div class="w-16 h-16 rounded-3xl bg-gradient-to-tr from-emerald-500 to-teal-400 p-0.5 mx-auto shadow-xl shadow-emerald-500/30 flex items-center justify-center">
        <div class="w-full h-full bg-[#0c0c16] rounded-[22px] flex items-center justify-center">
          <i id="kioskModalIcon" class="fa-solid fa-check text-2xl text-emerald-400"></i>
        </div>
      </div>
      <div>
        <span id="kioskModalBadge" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold font-mono uppercase bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">CHECK-IN CONFIRMED</span>
        <h3 id="kioskModalTitle" class="font-syne font-black text-xl text-white mt-1.5">Welcome!</h3>
        <p id="kioskModalSubtitle" class="text-xs text-gray-300 mt-1 font-mono">Clocked In at 10:15 AM</p>
      </div>
      <p id="kioskModalMessage" class="text-[11px] text-gray-400 italic">Have a productive and fabulous shift at Green Trends!</p>
      <button type="button" onclick="closeKioskCelebration()" class="w-full py-2.5 rounded-xl font-syne font-bold text-xs bg-[#161626] hover:bg-[#202036] text-gray-200 border border-[#2b2b40] cursor-pointer">
        Tap to Dismiss
      </button>
    </div>
  </div>

  <!-- Application Logic Scripts -->
  <script>
    // Fail-safe PWA modal open/close functions (works instantly under all browser conditions)
    function openPwaInstallHelpModal() {
      const m = document.getElementById('pwaModal');
      if (m) {
        m.classList.remove('hidden');
        m.style.display = 'flex';
      }
      // Highlight user's device
      try {
        const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
        const isAndroid = /android/i.test(navigator.userAgent);
        const bIos = document.getElementById('badgeIos');
        const bAndroid = document.getElementById('badgeAndroid');
        const bDesktop = document.getElementById('badgeDesktop');
        const stepIos = document.getElementById('pwaStepIos');
        const stepAndroid = document.getElementById('pwaStepAndroid');
        const stepDesktop = document.getElementById('pwaStepDesktop');
        
        if (isIOS) {
          if (bIos) bIos.classList.remove('hidden');
          if (stepIos) stepIos.classList.add('border-[#ff2a85]', 'bg-[#ff2a85]/10');
        } else if (isAndroid) {
          if (bAndroid) bAndroid.classList.remove('hidden');
          if (stepAndroid) stepAndroid.classList.add('border-emerald-500', 'bg-emerald-500/10');
        } else {
          if (bDesktop) bDesktop.classList.remove('hidden');
          if (stepDesktop) stepDesktop.classList.add('border-indigo-500', 'bg-indigo-500/10');
        }
      } catch (e) {}
    }
    function closePwaInstallModal() {
      const m = document.getElementById('pwaModal');
      if (m) {
        m.classList.add('hidden');
        m.style.display = 'none';
      }
    }
  </script>
  <script src="app.js?v=20260926_v15"></script>
</body>
</html>
